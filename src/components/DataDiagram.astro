---
// "Scattered data -> DreamLogic -> AI -> outcomes" diagram in the why section.
// Content comes from why.diagram in src/data/site.ts.
import { why } from '../data/site';
const d = why.diagram;
const n = d.sources.length;
const m = d.outputs.length;
const xs = (count: number) => Array.from({ length: count }, (_, i) => ((i + 0.5) / count) * 100);
const caption = `${d.sources.join(', ')} are connected, cleaned and combined by ${d.hub.label}, so ${d.ai} can ${d.outputs.map((o) => o.title.toLowerCase()).join(', ')}.`;
---
<figure class="dd">
  <p class="dd-kicker" aria-hidden="true">{d.sourcesLabel}</p>
  <ul class="dd-sources" aria-hidden="true" style={`--n:${n}`}>
    {d.sources.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}
  </ul>
  <svg class="dd-join" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    {xs(n).map((x) => <path d={`M${x} 0 C${x} 22 50 18 50 40`} />)}
  </svg>
  <div class="dd-hub" aria-hidden="true">
    <span class="dd-hub-label">{d.hub.label}</span>
    <span class="dd-hub-body">{d.hub.body}</span>
  </div>
  <svg class="dd-stem" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true"><path d="M50 0 V28" /></svg>
  <div class="dd-ai" aria-hidden="true">{d.ai}</div>
  <svg class="dd-split" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
    {xs(m).map((x) => <path d={`M50 0 C50 22 ${x} 18 ${x} 40`} />)}
  </svg>
  <ul class="dd-outputs" aria-hidden="true" style={`--m:${m}`}>
    {d.outputs.map((o) => <li><strong>{o.title}</strong><span>{o.body}</span></li>)}
  </ul>
  <figcaption class="sr-only">{caption}</figcaption>
</figure>

<style>
  .dd { margin: 1.25rem 0 0; max-width: 40rem; font-size: 0.9rem; font-weight: 400; line-height: 1.3; }
  .dd-kicker { margin: 0 0 0.75rem; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .dd-sources, .dd-outputs { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .dd-sources { grid-template-columns: repeat(var(--n), 1fr); }
  .dd-outputs { grid-template-columns: repeat(var(--m), 1fr); }
  .dd-sources li {
    display: grid; place-items: center; min-height: 3.25rem; padding: 0.5rem 0.25rem;
    text-align: center; color: var(--ink-2); background: var(--cloud);
    border: 1px dashed var(--slate); border-radius: 6px;
    transform: translateY(calc((var(--i) - 1.5) * (var(--i) - 1.5) * -3px)) rotate(calc((var(--i) - 1.5) * 1.5deg));
  }
  .dd-join, .dd-split, .dd-stem { display: block; width: 100%; height: 2.5rem; overflow: visible; }
  .dd-stem { height: 1.75rem; }
  .dd-join path { fill: none; stroke: var(--slate); stroke-width: 1.5; stroke-dasharray: 4 4; vector-effect: non-scaling-stroke; }
  .dd-stem path, .dd-split path { fill: none; stroke: var(--orange); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .dd-hub {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 0.25rem 0.75rem;
    padding: 0.9rem 1rem; text-align: center; background: var(--navy); color: #f3f5f6; border-radius: 8px;
  }
  .dd-hub-label { font-weight: 600; font-size: var(--step-0); }
  .dd-hub-body { color: var(--mist); }
  .dd-ai {
    width: 4.5rem; height: 4.5rem; margin: 0 auto; display: grid; place-items: center;
    border-radius: 50%; border: 2px solid var(--orange); background: var(--paper);
    font-weight: 600; font-size: var(--step-1); color: var(--orange-ink);
  }
  .dd-outputs li {
    display: grid; gap: 0.2rem; padding: 0.75rem 0.5rem; text-align: center;
    border-top: 2px solid var(--orange); background: var(--paper);
  }
  .dd-outputs strong { font-weight: 600; font-size: var(--step-0); color: var(--ink); }
  .dd-outputs span { color: var(--ink-2); }
  @media (width < 26rem) {
    .dd-sources li { font-size: 0.8rem; }
  }
</style>
