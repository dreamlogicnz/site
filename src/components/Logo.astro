---
// animated: the mark cycles through four versions (knot, cogs, loop, workflow). Without JavaScript,
// or with reduced motion on, it stays as the knot.
// size: the mark in px. wordRem: the wordmark's font size in rem. The mark and gap are set in em,
// so the whole logo shrinks together on narrow screens.
interface Props { size?: number; wordRem?: number; animated?: boolean }
const { size = 28, wordRem = 1.2, animated = false } = Astro.props;
const markEm = size / (wordRem * 16);

// A gear outline centred on (0,0): n teeth between root radius rr and tip radius rt, with a hole.
function cogPath(n: number, rr: number, rt: number, phase: number, hole: number) {
  const p = 360 / n;
  const pt = (r: number, a: number) => {
    const q = (a * Math.PI) / 180;
    return `${(r * Math.cos(q)).toFixed(2)} ${(r * Math.sin(q)).toFixed(2)}`;
  };
  let d = '';
  for (let i = 0; i < n; i++) {
    const a = phase + i * p;
    d += `${i ? `A${rr} ${rr} 0 0 1 ` : 'M'}${pt(rr, a - 0.27 * p)}L${pt(rt, a - 0.16 * p)}A${rt} ${rt} 0 0 1 ${pt(rt, a + 0.16 * p)}L${pt(rr, a + 0.27 * p)}`;
  }
  return `${d}A${rr} ${rr} 0 0 1 ${pt(rr, phase - 0.27 * p)}ZM${-hole} 0a${hole} ${hole} 0 1 0 ${2 * hole} 0a${hole} ${hole} 0 1 0 ${-2 * hole} 0Z`;
}
const inset = 'translate(60 60) scale(0.9) translate(-60 -60)';
---
<span class="logo" style={`--logo-word:${wordRem}rem;--logo-mark:${markEm}em`}>
  <svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true" focusable="false" data-logo-anim={animated ? '' : undefined}>
    <path d="M46 16H92a12 12 0 0 1 12 12V74" fill="none" stroke="currentColor" stroke-width="16" />
    <path d="M16 46V92a12 12 0 0 0 12 12H74" fill="none" stroke="currentColor" stroke-width="16" />
    <g fill="var(--orange)" data-knot>
      <rect x="40" y="30" width="14" height="36" />
      <rect x="54" y="40" width="36" height="14" />
      <rect x="66" y="54" width="14" height="36" />
      <rect x="30" y="66" width="36" height="14" />
    </g>
    {animated && (
      <g data-extra style="display:none">
        <g fill="var(--orange)" fill-rule="evenodd" transform={inset}>
          <g transform="translate(50 69)"><g data-big><path d={cogPath(8, 16.5, 23.5, -45, 7)} /></g></g>
          <g transform="translate(75 44)"><g data-small><path d={cogPath(6, 11.5, 18.5, 165, 5)} /></g></g>
        </g>
        <g transform={inset}>
          <g data-spin>
            <path data-a1 d="M36 60V38H70" fill="none" stroke="var(--orange)" stroke-width="10" stroke-dasharray="56 56" />
            <path data-h1 d="M70 27L85 38L70 49Z" fill="var(--orange)" />
            <path data-a2 d="M84 60V82H50" fill="none" stroke="var(--orange)" stroke-width="10" stroke-dasharray="56 56" />
            <path data-h2 d="M50 71L35 82L50 93Z" fill="var(--orange)" />
          </g>
        </g>
        <g data-steps fill="none" stroke="var(--orange)" stroke-width="5">
          <rect data-n1 x="32.5" y="32.5" width="11" height="11" />
          <rect data-f1 x="30" y="30" width="16" height="16" fill="var(--orange)" stroke="none" />
          <path data-l1 d="M38 46V60H52" stroke-dasharray="28 28" />
          <rect data-n2 x="54.5" y="54.5" width="11" height="11" />
          <rect data-f2 x="52" y="52" width="16" height="16" fill="var(--orange)" stroke="none" />
          <g data-other>
            <path data-lb d="M68 60H80V46" stroke-dasharray="26 26" />
            <rect data-alt x="74.5" y="32.5" width="11" height="11" />
          </g>
          <path data-lf d="M60 68V79H68" stroke-dasharray="19 19" />
          <rect data-fin x="70.5" y="70.5" width="17" height="17" />
          <rect data-ffin x="68" y="68" width="22" height="22" fill="var(--orange)" stroke="none" />
        </g>
      </g>
    )}
  </svg>
  <span class="word">Dream<b>Logic</b></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.46em; color: inherit; font-size: min(var(--logo-word), 9.5vw); }
  .logo svg { width: var(--logo-mark); height: var(--logo-mark); flex: none; }
  .word { font-size: 1em; font-weight: 300; letter-spacing: -0.02em; line-height: 1; }
  .word b { font-weight: 600; }
</style>

<script>
  // Cycles the mark: knot (3s), cogs turning (5.5s), loop drawn (5s), workflow built (6.5s), then round again.
  // Everything is worked out from the time alone, so it never drifts.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const svgs = reduce ? [] : Array.from(document.querySelectorAll<SVGSVGElement>('svg[data-logo-anim]'));

  const clamp = (x: number) => Math.max(0, Math.min(1, x));
  const seg = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
  const ei = (x: number) => x * x * x;
  const eo = (x: number) => 1 - Math.pow(1 - x, 3);
  const eio = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const eob = (x: number, o = 1.4) => 1 + (o + 1) * Math.pow(x - 1, 3) + o * Math.pow(x - 1, 2);
  const about = (el: Element, cx: number, cy: number, s: number, rot = 0) =>
    el.setAttribute('transform', `translate(${cx} ${cy}) rotate(${rot.toFixed(2)}) scale(${Math.max(0.0001, s).toFixed(4)}) translate(${-cx} ${-cy})`);
  const draw = (el: SVGElement, len: number, d: number) => {
    el.style.strokeDashoffset = (len * (1 - d)).toFixed(2);
    el.style.opacity = d > 0.001 ? '1' : '0';
  };
  const cogTurn = (u: number) => 40 * (u <= 0 ? 0 : u < 0.6 ? (0.5 * u * u) / 0.6 : u - 0.3);
  const BARS = [[47, 48], [72, 47], [73, 72], [48, 73]];
  const TOTAL = 20;

  for (const svg of svgs) {
    const q = (name: string) => svg.querySelector(`[data-${name}]`) as SVGElement;
    const bars = Array.from(svg.querySelectorAll('[data-knot] rect'));
    const el = Object.fromEntries(
      ['extra', 'big', 'small', 'spin', 'a1', 'h1', 'a2', 'h2', 'steps', 'n1', 'f1', 'l1', 'n2', 'f2', 'other', 'lb', 'alt', 'lf', 'fin', 'ffin'].map((n) => [n, q(n)]),
    );
    el.extra.style.display = '';

    const render = (t: number) => {
      // Knot: grows in at the start of the cycle, ticks twice round, then shrinks away for the cogs.
      bars.forEach((bar, i) => {
        const tick = Math.sin(Math.PI * seg(t, 0.9 + i * 0.22, 1.35 + i * 0.22)) + Math.sin(Math.PI * seg(t, 1.9 + i * 0.22, 2.35 + i * 0.22));
        const k = t < 3 ? eo(seg(t, 0.15 + i * 0.07, 0.5 + i * 0.07)) * (1 + 0.13 * tick) : 1 - ei(seg(t - 3, 0.05 + i * 0.07, 0.4 + i * 0.07));
        about(bar, BARS[i][0], BARS[i][1], k);
      });
      // Cogs: pop in, turn against each other, shrink away for the loop.
      const c = t - 3, cOut = 1 - ei(seg(t - 8.5, 0, 0.45)), deg = cogTurn(c - 1);
      el.big.setAttribute('transform', `rotate(${deg.toFixed(2)}) scale(${Math.max(0.0001, eob(seg(c, 0.5, 1.0)) * cOut).toFixed(4)})`);
      el.small.setAttribute('transform', `rotate(${((-deg * 8) / 6).toFixed(2)}) scale(${Math.max(0.0001, eob(seg(c, 0.68, 1.15)) * cOut).toFixed(4)})`);
      // Loop: one arrow is drawn, then the other, then the pair goes round half a turn.
      const l = t - 8.5;
      draw(el.a1, 56, eio(seg(l, 0.55, 1.35)));
      about(el.h1, 70, 38, eob(seg(l, 1.3, 1.6)));
      draw(el.a2, 56, eio(seg(l, 1.7, 2.5)));
      about(el.h2, 50, 82, eob(seg(l, 2.45, 2.75)));
      about(el.spin, 60, 60, 1 - ei(seg(t - 13.5, 0, 0.45)), 180 * eio(seg(l, 3.1, 4.3)));
      // Workflow: a level at a time, then a branch. The chosen boxes fill; the other stays open.
      // It is still on screen for the first moment of the next cycle, shrinking away as the knot returns.
      const f = t < 3 ? 6.5 + t : t - 13.5;
      about(el.n1, 38, 38, eob(seg(f, 0.6, 0.95)));
      about(el.f1, 38, 38, eo(seg(f, 1.05, 1.35)));
      draw(el.l1, 28, eio(seg(f, 1.4, 1.9)));
      about(el.n2, 60, 60, eob(seg(f, 1.9, 2.25)));
      about(el.f2, 60, 60, eo(seg(f, 2.35, 2.65)));
      draw(el.lb, 26, eio(seg(f, 2.75, 3.25)));
      draw(el.lf, 19, eio(seg(f, 2.75, 3.25)));
      about(el.alt, 80, 38, eob(seg(f, 3.25, 3.6)));
      about(el.fin, 79, 79, eob(seg(f, 3.25, 3.6)));
      about(el.ffin, 79, 79, eob(seg(f, 4.1, 4.5), 1.6));
      el.other.style.opacity = String(1 - 0.55 * eio(seg(f, 4.1, 4.6)));
      about(el.steps, 60, 60, t < 3 ? 1 - ei(seg(t, 0, 0.45)) : 1);
    };

    // Start just after the knot has settled, so the first frame matches the still logo.
    const start = performance.now() - 750;
    const frame = (now: number) => {
      render(((now - start) / 1000) % TOTAL);
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
