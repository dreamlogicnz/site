---
// size: the mark in px. wordRem: the wordmark's font size in rem.
// The mark and gap are set in em, so the whole logo shrinks together on narrow screens.
interface Props { size?: number; wordRem?: number }
const { size = 84, wordRem = 3.6 } = Astro.props;
const markEm = size / (wordRem * 16);
---
<span class="logo" style={`--logo-word:${wordRem}rem;--logo-mark:${markEm}em`}>
  <svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <path d="M46 16H92a12 12 0 0 1 12 12V74" fill="none" stroke="currentColor" stroke-width="16" />
    <path d="M16 46V92a12 12 0 0 0 12 12H74" fill="none" stroke="currentColor" stroke-width="16" />
    <g fill="var(--orange)">
      <rect x="40" y="30" width="14" height="36" />
      <rect x="54" y="40" width="36" height="14" />
      <rect x="66" y="54" width="14" height="36" />
      <rect x="30" y="66" width="36" height="14" />
    </g>
  </svg>
  <span class="word">Dream<b>Logic</b></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.46em; color: inherit; font-size: min(var(--logo-word), 12vw); }
  .logo svg { width: var(--logo-mark); height: var(--logo-mark); flex: none; }
  .word { font-size: 1em; font-weight: 300; letter-spacing: -0.02em; line-height: 1; }
  .word b { font-weight: 600; }
</style>
